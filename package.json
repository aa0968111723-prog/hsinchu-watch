{
  "name": "hsinchu-watch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build:ui": "vite build --outDir .build-ui",
    "test:release": "python -m unittest discover -s tools/release -p test_*.py",
    "test:integrate": "python -m unittest discover -s tools/integrate -p test_*.py",
    "test:site": "node tools/release/verify-production.mjs",
    "test:mobile": "node tools/release/verify-mobile.mjs",
    "test:browser": "python tools/check_site.py",
    "audit:publication": "python tools/audit_publication.py"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "wrangler": "^4.159.0",
    "playwright": "1.65.0"
  }
}
