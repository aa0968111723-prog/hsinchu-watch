{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsinchu-watch.invalid/schemas/hourly-batch-1.json",
  "title": "hourly-batch/1",
  "type": "object",
  "required": ["schema", "batch_id", "revision", "state_sha", "created_at", "source_commit", "base_main_commit",
               "base_live_release", "live_manifest_hash", "file_hashes", "counts", "review_policy", "events"],
  "properties": {
    "schema": {"const": "hourly-batch/1"},
    "batch_id": {"type": "string", "pattern": "^b[0-9]{6}-[0-9a-f]{10}$"},
    "revision": {"type": "integer", "minimum": 1},
    "state_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prev_batch_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": ["string", "null"]},
    "base_main_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "base_live_release": {"type": ["string", "null"]},
    "live_manifest_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "counts": {"type": "object", "required": ["added", "changed", "withdrawn", "pending_review"],
               "properties": {"added": {"type": "integer", "minimum": 0}, "changed": {"type": "integer", "minimum": 0},
                              "withdrawn": {"type": "integer", "minimum": 0}, "pending_review": {"type": "integer", "minimum": 0}}},
    "review_policy": {"type": "string", "pattern": "pending_review"},
    "events": {"type": "array", "items": {"type": "object", "required": ["event_key", "type", "item_id"],
               "properties": {"type": {"enum": ["item_added", "item_changed", "item_withdrawn"]},
                              "verification": {"const": "待審"}},
               "additionalProperties": true}},
    "new_exclusions": {"type": "array", "items": {"type": "object", "properties": {"ref": {"type": "string", "not": {"pattern": "^[hH][tT][tT][pP][sS]?://"}}}}}
  },
  "additionalProperties": true
}
