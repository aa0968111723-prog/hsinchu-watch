{
  "name": "hsinchu-news-intel",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hsinchu-news-intel",
      "database_id": "REPLACE_AFTER_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ]
}
